# LeoMoney V4 — 美股 / 加密个人模拟交易工作台
PORT=3210
LEOMONEY_VERSION_CHANNEL=commercial-beta
LEOMONEY_DATA_DIR=./data
LEOMONEY_ALLOWED_ORIGINS=http://localhost:3210,http://localhost:5174
LEOMONEY_REQUEST_BODY_LIMIT=256kb
LEOMONEY_RATE_LIMIT_WINDOW_MS=60000
LEOMONEY_RATE_LIMIT_MAX_REQUESTS=600

# Simulated-trading safety controls
LEOMONEY_PAPER_EXECUTION_ENABLED=true
# Keep direct legacy Agent proposal execution disabled. Use /api/automation/run execution gate.
LEOMONEY_AGENT_PAPER_EXECUTION_ENABLED=false
LEOMONEY_MAX_ORDER_QTY=100000000
LEOMONEY_MAX_ORDER_NOTIONAL_CNY=5000000
LEOMONEY_MAX_ORDER_PRICE=10000000

# LLM provider configuration.
# 配置后启用情报标题/摘要中文化、结构化标的映射和 Agent 深度解读。
# 股票、ETF、指数、币种、交易对、金融产品名不会被强制翻译，Apple/NVIDIA/BTC/ETH/SPY 等可保留英文。
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
LLM_MODEL=deepseek-v4-flash
LLM_QUICK_MODEL=deepseek-v4-flash
LLM_DEEP_MODEL=deepseek-v4-pro
LLM_API_KEY=
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=1

# Research Desk configuration.
# quick 用于摘要/轻分析，deep 用于深度辩论和组合经理审稿；留空时回退到 LLM_MODEL。
RESEARCH_QUICK_MODEL=deepseek-v4-flash
RESEARCH_DEEP_MODEL=deepseek-v4-pro
RESEARCH_DEBATE_ROUNDS=1
RESEARCH_RISK_DISCUSS_ROUNDS=1
RESEARCH_OUTPUT_LANGUAGE=zh
RESEARCH_DEFAULT_BENCHMARK_US=QQQ
RESEARCH_DEFAULT_BENCHMARK_CRYPTO=BTCUSDT

# Optional search/intelligence provider.
SEARCH_API_KEY=
SEARCH_API_URL=

# Market data provider controls.
# Defaults use free public sources first. Fill keys only after deciding to buy a provider.
MARKET_DATA_PREFERRED_PROVIDER=free_first
MARKET_DATA_KLINE_CACHE_TTL_MS=15000
ALPACA_API_KEY=
ALPACA_API_SECRET=
POLYGON_API_KEY=
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
EODHD_API_KEY=
DATABENTO_API_KEY=
INTRINIO_API_KEY=
TUSHARE_TOKEN=
FUTU_OPEND_HOST=
FUTU_OPEND_PORT=
