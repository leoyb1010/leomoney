# LeoMoney commercial beta runtime configuration
PORT=3210
LEOMONEY_VERSION_CHANNEL=commercial-beta
LEOMONEY_DATA_DIR=./data
LEOMONEY_ALLOWED_ORIGINS=http://localhost:3210
LEOMONEY_REQUEST_BODY_LIMIT=256kb
LEOMONEY_RATE_LIMIT_WINDOW_MS=60000
LEOMONEY_RATE_LIMIT_MAX_REQUESTS=600

# Simulated-trading safety controls
LEOMONEY_PAPER_EXECUTION_ENABLED=true
# Keep direct legacy Agent proposal execution disabled. Use /api/automation/run execution gate.
LEOMONEY_AGENT_PAPER_EXECUTION_ENABLED=false
LEOMONEY_MAX_ORDER_QTY=100000000
LEOMONEY_MAX_ORDER_NOTIONAL_CNY=5000000
LEOMONEY_MAX_ORDER_PRICE=10000000

# LLM provider configuration. Leave unset to run in safe HOLD/no-key mode.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=1

# Optional search/intelligence provider.
SEARCH_API_KEY=
SEARCH_API_URL=
